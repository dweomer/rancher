#!/bin/bash
set -e

source $(dirname $0)/version

cd $(dirname $0)/..

mkdir -p bin

if [ -n "${DEBUG}" ]; then
  GCFLAGS="-N -l"
fi

if [ "$(uname)" != "Darwin" ]; then
  LINKFLAGS="-w -linkmode=external -extldflags=-static"
  if [ -z "${DEBUG}" ]; then
    LINKFLAGS="${LINKFLAGS} -s"
  fi
fi

GOEXPERIMENT=boringcrypto go build -tags k8s,netgo,osusergo \
  -gcflags="all=${GCFLAGS}" \
  -ldflags "-X main.VERSION=$VERSION $LINKFLAGS" \
  -o bin/agent ./cmd/agent
